{
  "name": "Growth OS — Follow-up processor (every 15 min)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GROWTH_OS_API }}/outreach/process-due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Internal-Key", "value": "={{ $env.GROWTH_OS_INTERNAL_KEY }}" }]
        },
        "options": { "timeout": 300000 }
      },
      "name": "Process due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "Process due follow-ups", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
