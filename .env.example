# ── Database (Supabase → Project Settings → Database → Connection string, use the
#    "Session pooler" URI on Railway; direct connection works locally)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Supabase Auth (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret          # verifies user tokens in FastAPI
AUTH_DISABLED=true                           # set false in production

# ── Google Places API (New). Enable "Places API (New)" in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# ── Anthropic (audits, emails, call scripts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Resend (outreach email). Verify your sending domain first.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=will@yourdomain.com
OUTREACH_FROM_NAME=Will Hoge
RESEND_WEBHOOK_SECRET=                       # svix secret from Resend webhook config

# ── App
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
INTERNAL_API_KEY=change-me-long-random       # protects n8n/cron endpoints
ENVIRONMENT=development

# ── Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
