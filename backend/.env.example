# Copy to .env for local dev. On Railway, set these under Variables.
#
# ⚠️ CRITICAL — missing these two caused two production outages in one week:
# the server doesn't crash loudly when they're absent, it just fails auth
# for every logged-in request with a confusing error. If the dashboard shows
# "API unreachable" or "Failed to fetch" after a fresh deploy, check these
# two FIRST.
SUPABASE_URL=https://kygrstickwfivbabregq.supabase.co
SUPABASE_ANON_KEY=                    # Supabase → Settings → API Keys → "Publishable key" (starts sb_publishable_...). NEVER use the Secret key here.

# Required — database connection (Supabase → Settings → Database → Connection string, pooler mode)
DATABASE_URL=

# Required — must exactly match the same value in GitHub → repo Settings →
# Secrets and variables → Actions → INTERNAL_API_KEY, or the monthly
# ingestion sweep and cron jobs fail silently.
INTERNAL_API_KEY=

# Required — locks down CORS. No trailing slash.
FRONTEND_URL=https://growth-os-2-uwis.vercel.app

# Security — leave unset (defaults to false) on every real deployment.
# true is for local dev ONLY. The server refuses to even start with this
# true on a non-local FRONTEND_URL (see auth.py).
AUTH_DISABLED=false

# Google Places (business discovery/scoring)
GOOGLE_PLACES_API_KEY=

# Brave Search (website discovery for "no website" businesses — free tier: 2000/mo)
BRAVE_SEARCH_API_KEY=

# Claude (audits, call scripts, cold emails)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Resend (outbound email)
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
RESEND_WEBHOOK_SECRET=                # Resend → Webhooks → signing secret (verifies inbound reply/bounce/open events)
WARMUP_RECIPIENTS=                    # comma-separated inboxes YOU control, used only for domain warm-up sends

# Misc
API_BASE_URL=http://localhost:8000
ENVIRONMENT=production
